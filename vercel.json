{
  "cleanUrls": true,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/js/(config|neon-auth|sb).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(kabinet|admin)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/kursy/:slug/uroki(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/kursy/:slug([a-z0-9-]+)/uroki",
      "destination": "/kursy/urok.html"
    },
    {
      "source": "/kursy/:slug([a-z0-9-]+)/uroki/",
      "destination": "/kursy/urok.html"
    },
    {
      "source": "/kursy/:slug([a-z0-9-]+)",
      "destination": "/kursy/kurs.html"
    },
    {
      "source": "/kursy/:slug([a-z0-9-]+)/",
      "destination": "/kursy/kurs.html"
    }
  ]
}
